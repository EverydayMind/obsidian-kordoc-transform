{
  "name": "kordoc-transform",
  "version": "4.24.59r1",
  "description": "Convert Korean HWP, HWPX and HWPML documents, PDF, Excel, Word and PowerPoint files to Markdown, preview and edit HWPX, and export Markdown to HWPX offline.",
  "private": true,
  "type": "module",
  "author": "everydaymind",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate-validators.mjs && node scripts/prepare-lazy.mjs --check && node scripts/embed-assets.mjs --check && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "release:check": "node scripts/check-release.mjs",
    "check:bundle": "node scripts/check-bundle.mjs main.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ajv": "6.15.0",
    "cfb": "1.2.2",
    "kordoc": "4.24.59",
    "markdown-it": "14.3.3",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "20.19.35",
    "ajv8": "npm:ajv@8.20.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "jszip": "3.10.1",
    "obsidian": "1.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "moment": "2.31.0",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
