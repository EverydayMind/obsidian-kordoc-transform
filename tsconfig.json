{
  "compilerOptions": {
    "baseUrl": ".", "module": "ESNext", "target": "ES2020", "moduleResolution": "Bundler",
    "allowJs": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "noImplicitAny": false, "strictNullChecks": true, "skipLibCheck": true,
    "lib": ["DOM", "ES2020"], "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
